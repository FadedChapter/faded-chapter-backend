# Monitoring & Observability Configuration

# Sentry Error Tracking
# Get DSN from https://sentry.io/
SENTRY_DSN=https://<key>@sentry.io/<project>

# Slack Integration for Alerts
# Get webhook from https://api.slack.com/apps
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-secure-password

# Prometheus Configuration
PROMETHEUS_RETENTION_DAYS=7
PROMETHEUS_SCRAPE_INTERVAL_SECONDS=15
PROMETHEUS_EVALUATION_INTERVAL_SECONDS=15

# Node Environment
NODE_ENV=production

# Database for Monitoring
DATABASE_URL=postgresql://test:test@postgres:5432/faded_chapter_test

# Application
APP_VERSION=1.0.0
APP_NAME=faded-chapter-backend

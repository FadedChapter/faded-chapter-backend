# Test Environment Configuration
# Used when NODE_ENV=test

NODE_ENV=test
PORT=3001

# Test Database (separate from dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/faded_chapter_test

# Auth Secrets (safe to expose in test)
JWT_SECRET=test-jwt-secret-min-32-characters-here-
SESSION_SECRET=test-session-secret-min-32-chars-

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging (reduced verbosity for tests)
LOG_LEVEL=error

# Features
FEATURE_EMAIL_VERIFICATION=true
FEATURE_SMS=false

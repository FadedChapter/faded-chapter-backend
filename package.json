{
  "name": "faded-chapter-backend",
  "version": "1.0.0",
  "description": "Faded Chapter Express Backend API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "db:migrate": "typeorm migration:run -d dist/core/database/migrations-datasource.js",
    "db:migration:create": "typeorm migration:create",
    "db:migration:generate": "typeorm migration:generate -d dist/core/database/migrations-datasource.js",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "seed:catalog": "tsx src/scripts/seed-catalog.ts"
  },
  "keywords": [
    "faded-chapter",
    "backend",
    "express",
    "api"
  ],
  "author": "Faded Chapter",
  "license": "MIT",
  "dependencies": {
    "@faded-chapter/types": "file:../faded-chapter-types",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.3",
    "razorpay": "^2.9.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2",
    "winston": "^3.13.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2",
    "vitest": "^1.6.0",
    "@types/pg": "^8.11.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
